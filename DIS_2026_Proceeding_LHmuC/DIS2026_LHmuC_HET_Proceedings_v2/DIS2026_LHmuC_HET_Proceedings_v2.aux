\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Exploratory $\kappa $-3 fit projections from HELP4CERN~\cite  {HELP4CERN}: fermion modifiers (upper left), vector modifiers and invisible/undetected branching fractions (upper right), and effective loop-induced modifiers (lower). The legend identifies the LHeC and combined LHeC+LH$\mu $C\ stages; dashed lines show HL-LHC baselines. Coupling uncertainties and absolute branching-fraction constraints are in percent. The fit imposes $\kappa _V\le 1$, with the vector convention defined in the text.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:higgs-couplings}{{3}{5}{Exploratory $\kappa $-3 fit projections from HELP4CERN~\cite {HELP4CERN}: fermion modifiers (upper left), vector modifiers and invisible/undetected branching fractions (upper right), and effective loop-induced modifiers (lower). The legend identifies the LHeC and combined LHeC+\lhmuc \ stages; dashed lines show HL-LHC baselines. Coupling uncertainties and absolute branching-fraction constraints are in percent. The fit imposes $\kappa _V\le 1$, with the vector convention defined in the text}{figure.caption.5}{}}
