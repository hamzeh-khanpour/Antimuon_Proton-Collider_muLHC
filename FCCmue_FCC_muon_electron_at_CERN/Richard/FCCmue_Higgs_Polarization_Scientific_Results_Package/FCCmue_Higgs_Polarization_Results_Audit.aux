\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Leading-order Standard Model cross sections for single- and double-Higgs-boson production in $\mu ^+e^-$ collisions as functions of the longitudinal polarization of the positive-muon beam, $P_{\mu ^+}$. The four processes considered are $\mu ^+e^-\to \bar  {\nu }_{\mu }\nu _e H$, $\mu ^+e^-\to \bar  {\nu }_{\mu }\nu _e HH$ (charged current), and $\mu ^+e^-\to \mu ^+e^-H$, $\mu ^+e^-\to \mu ^+e^-HH$ (neutral current). Results are shown for center-of-mass energies of $\sqrt  {s}=1$ and $2$~TeV, with an unpolarized electron beam and $P_{\mu ^+}$ varying from $0\%$ to $100\%$. The calculations employ the full tree-level Standard Model matrix elements, without imposing kinematic phase-space cuts. Cross sections are expressed in femtobarns (fb). Error bars represent the Monte Carlo integration uncertainties. }}{1}{figure.1}\protected@file@percent }
\newlabel{fig: FCCmue_absolute_cross_sections}{{1}{1}{Leading-order Standard Model cross sections for single- and double-Higgs-boson production in $\mu ^+e^-$ collisions as functions of the longitudinal polarization of the positive-muon beam, $P_{\mu ^+}$. The four processes considered are $\mu ^+e^-\to \bar {\nu }_{\mu }\nu _e H$, $\mu ^+e^-\to \bar {\nu }_{\mu }\nu _e HH$ (charged current), and $\mu ^+e^-\to \mu ^+e^-H$, $\mu ^+e^-\to \mu ^+e^-HH$ (neutral current). Results are shown for center-of-mass energies of $\sqrt {s}=1$ and $2$~TeV, with an unpolarized electron beam and $P_{\mu ^+}$ varying from $0\%$ to $100\%$. The calculations employ the full tree-level Standard Model matrix elements, without imposing kinematic phase-space cuts. Cross sections are expressed in femtobarns (fb). Error bars represent the Monte Carlo integration uncertainties}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Dependence of the normalized Higgs-production cross sections on the longitudinal positive-muon beam polarization in $\mu ^+e^-$ collisions. The polarization enhancement factor is defined as $R(P_{\mu ^+})=\sigma (P_{\mu ^+})/\sigma (0)$, where $\sigma (0)$ denotes the corresponding unpolarized cross section. Results are presented for charged-current and neutral-current single- and double-Higgs production at $\sqrt  {s}=1$ and $2$~TeV. }}{2}{figure.2}\protected@file@percent }
\newlabel{fig: FCCmue_polarization_ratios}{{2}{2}{Dependence of the normalized Higgs-production cross sections on the longitudinal positive-muon beam polarization in $\mu ^+e^-$ collisions. The polarization enhancement factor is defined as $R(P_{\mu ^+})=\sigma (P_{\mu ^+})/\sigma (0)$, where $\sigma (0)$ denotes the corresponding unpolarized cross section. Results are presented for charged-current and neutral-current single- and double-Higgs production at $\sqrt {s}=1$ and $2$~TeV}{figure.2}{}}
